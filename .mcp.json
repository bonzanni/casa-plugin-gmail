{
  "mcpServers": {
    "gmail": {
      "command": "${CLAUDE_PLUGIN_ROOT}/server/.venv/bin/python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/server.py"],
      "env": {
        "GMAIL_IMPERSONATION_SA": "${GMAIL_IMPERSONATION_SA}",
        "GMAIL_SUBJECT_EMAIL": "${GMAIL_SUBJECT_EMAIL}",
