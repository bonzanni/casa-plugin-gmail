{
  "name": "gmail",
  "version": "0.16.0",
  "description": "Gmail integration for the agent — read, search, send, manage the user's inbox via per-user OAuth 2.0. Consent completes through casa's authorization-callback endpoint; the refresh token is persisted in plugin data.",
  "author": {"name": "Nicola Bonzanni", "url": "https://github.com/bonzanni"},
  "homepage": "https://github.com/bonzanni/casa-plugin-gmail",
  "repository": "https://github.com/bonzanni/casa-plugin-gmail",
  "license": "MIT",
  "keywords": ["casa", "gmail", "oauth", "mcp", "email"],
  "casa": {
    "callbacks": [{"name": "oauth"}],
    "setupTool": "setup_gmail",
    "provides_tools": [
      "mcp__plugin_gmail_gmail__setup_gmail",
      "mcp__plugin_gmail_gmail__gmail_auth_collect",
      "mcp__plugin_gmail_gmail__search_emails",
      "mcp__plugin_gmail_gmail__get_email",
      "mcp__plugin_gmail_gmail__get_thread",
      "mcp__plugin_gmail_gmail__manage_email",
      "mcp__plugin_gmail_gmail__list_attachments",
      "mcp__plugin_gmail_gmail__download_attachment",
      "mcp__plugin_gmail_gmail__send_attachment_to_chat",
      "mcp__plugin_gmail_gmail__save_attachment",
      "mcp__plugin_gmail_gmail__list_send_as",
      "mcp__plugin_gmail_gmail__send_email",
      "mcp__plugin_gmail_gmail__reply_to_thread",
      "mcp__plugin_gmail_gmail__erase_gmail",
      "mcp__plugin_gmail_gmail__erase_gmail_data",
      "mcp__plugin_gmail_gmail__bulk_manage",
      "mcp__plugin_gmail_gmail__list_labels",
      "mcp__plugin_gmail_gmail__create_label",
      "mcp__plugin_gmail_gmail__update_label",
      "mcp__plugin_gmail_gmail__delete_label",
      "mcp__plugin_gmail_gmail__list_filters",
      "mcp__plugin_gmail_gmail__create_filter",
      "mcp__plugin_gmail_gmail__delete_filter"
    ],
    "profiles": {
      "read": ["search_emails", "get_email", "get_thread", "list_attachments", "download_attachment", "send_attachment_to_chat", "list_send_as", "list_labels", "list_filters"]
    },
    "eraseTool": "erase_gmail",
    "eraseDataOnlyTool": "erase_gmail_data",
    "protectedTools": [
      {"name": "send_email", "summary": "Send email to {to} (and to any cc or bcc listed): {subject}"},
      {"name": "reply_to_thread", "summary": "Reply to: {display_subject} (and to any cc or bcc listed)"},
      {"name": "erase_gmail", "summary": "Revokes Gmail's access at Google and deletes the stored sign-in, the sent log and saved attachments. Reconnecting needs a new sign-in."},
      {"name": "erase_gmail_data", "summary": "Deletes the sent log and saved attachments; keeps the Gmail sign-in, so a reinstall stays connected."},
      {"name": "create_filter", "summary": "Create a Gmail filter for new mail matching: {query}"},
      {"name": "delete_filter", "summary": "Delete the Gmail filter: {description}"},
      {"name": "delete_label", "summary": "Delete the Gmail label \"{label}\" (mail stays, the label comes off every message)"}
    ],
    "resultContract": {
      "version": 1,
      "tools": {
        "setup_gmail": {"result": "capability", "provides": ["auth_url"],
                        "delivers": {"auth_url": "operator_link"}},
        "gmail_auth_collect": {"result": "safe"},
        "search_emails": {"result": "safe"},
        "get_email": {"result": "safe"},
        "get_thread": {"result": "safe"},
        "manage_email": {"result": "safe"},
        "list_attachments": {"result": "safe"},
        "download_attachment": {"result": "safe"},
        "send_attachment_to_chat": {"result": "capability", "provides": ["file"],
                                    "delivers": {"file": "operator_file"}, "filename": true},
        "save_attachment": {"result": "safe"},
        "list_send_as": {"result": "safe"},
        "send_email": {"result": "safe"},
        "reply_to_thread": {"result": "safe"},
        "erase_gmail": {"result": "safe"},
        "erase_gmail_data": {"result": "safe"},
        "bulk_manage": {"result": "safe"},
        "list_labels": {"result": "safe"},
        "create_label": {"result": "safe"},
        "update_label": {"result": "safe"},
        "delete_label": {"result": "safe"},
        "list_filters": {"result": "safe"},
        "create_filter": {"result": "safe"},
        "delete_filter": {"result": "safe"}
      }
    }
  }
}
